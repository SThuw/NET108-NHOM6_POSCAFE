@model CreateProductDto
@using CafePOSManagement.Web.Models.Entities
@{
    ViewData["PageClass"] = "management-page";
    var product = ViewBag.Product as Product;
    var editing = product is not null;
    ViewData["Title"] = editing ? "Sửa sản phẩm" : "Thêm món mới";
    var categories = ViewBag.Categories as IReadOnlyList<Category> ?? [];
    var returnUrl = (string)ViewBag.ReturnUrl;
}
<div class="management-shell">
    <div class="management-heading">
        <div>
            <p class="management-eyebrow">QUẢN LÝ SẢN PHẨM</p>
            <h1>@ViewData["Title"]</h1>
            <p class="text-muted">@(editing ? "Cập nhật thông tin món, giá bán và trạng thái phục vụ." : "Nhập thông tin món mới cho thực đơn của quán.")</p>
        </div>
        <a href="@returnUrl" class="btn btn-outline-secondary">
            <svg class="icon"><use href="#i-arrow" /></svg>
            <span>Về danh sách</span>
        </a>
    </div>

    <div class="management-card form-shell mx-auto">
        <form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@product?.Id" asp-route-returnUrl="@returnUrl" method="post" class="management-form" data-disable-on-submit>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

            <div class="form-grid">
                <div>
                    <label asp-for="Name" class="form-label">Tên món <span class="text-danger" aria-hidden="true">*</span></label>
                    <input asp-for="Name" class="form-control" maxlength="100" required placeholder="Ví dụ: Cà phê sữa đá" />
                    <span asp-validation-for="Name" class="field-error"></span>
                </div>
                <div>
                    <label asp-for="CategoryId" class="form-label">Danh mục <span class="text-danger" aria-hidden="true">*</span></label>
                    <select asp-for="CategoryId" class="form-select" required>
                        <option value="">-- Chọn danh mục --</option>
                        @foreach (var category in categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="field-error"></span>
                </div>
                <div>
                    <label asp-for="Price" class="form-label">Giá bán (₫) <span class="text-danger" aria-hidden="true">*</span></label>
                    <input asp-for="Price" class="form-control" type="number" min="1" max="10000000" step="1" required placeholder="35000" />
                    <span asp-validation-for="Price" class="field-error"></span>
                </div>
                <div>
                    <label asp-for="OriginalPrice" class="form-label">Giá gốc (₫)</label>
                    <input asp-for="OriginalPrice" class="form-control" type="number" min="1" max="10000000" step="1" placeholder="Tùy chọn..." />
                    <span asp-validation-for="OriginalPrice" class="field-error"></span>
                </div>
                <div class="full">
                    <label asp-for="ImageUrl" class="form-label">Đường dẫn ảnh HTTPS</label>
                    <input asp-for="ImageUrl" class="form-control" type="url" maxlength="500" placeholder="https://..." data-image-preview-input />
                    <span asp-validation-for="ImageUrl" class="field-error"></span>
                    <small class="form-text text-muted">@(editing ? "Để trống để giữ ảnh hiện tại." : "Để trống để dùng ảnh mặc định.")</small>
                </div>
                <div class="full">
                    <label asp-for="Description" class="form-label">Mô tả món</label>
                    <textarea asp-for="Description" class="form-control" rows="3" maxlength="1000" placeholder="Hương vị, thành phần..."></textarea>
                    <span asp-validation-for="Description" class="field-error"></span>
                </div>
                <div class="full form-check">
                    <input asp-for="IsAvailable" class="form-check-input" id="is-available-input" />
                    <label asp-for="IsAvailable" class="form-check-label" for="is-available-input">Đang bán trên quầy POS</label>
                </div>
            </div>

            <div class="image-preview mt-3">
                <span class="form-label d-block mb-2">Ảnh xem trước</span>
                <img src="@(product?.ImageUrl ?? "/images/product-fallback.svg")" data-original-src="@(product?.ImageUrl ?? "/images/product-fallback.svg")" data-image-preview data-image-fallback alt="Ảnh xem trước của món" class="management-preview-img" />
            </div>

            <div class="form-actions mt-4 pt-3 border-top d-flex gap-2 justify-content-end">
                <a href="@returnUrl" class="btn btn-outline-secondary">Hủy bỏ</a>
                <button type="submit" class="btn btn-primary" data-saving-label="Đang lưu...">Lưu món</button>
            </div>
        </form>
    </div>
</div>
