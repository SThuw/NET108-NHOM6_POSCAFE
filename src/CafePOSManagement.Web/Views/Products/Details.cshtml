@model CafePOSManagement.Web.Models.Entities.Product
@{
    ViewData["Title"] = "Chi tiết món · " + Model.Name;
    ViewData["PageClass"] = "management-page";
    var returnUrl = (string)ViewBag.ReturnUrl;
}
<div class="management-shell">
    <div class="management-heading">
        <div>
            <p class="management-eyebrow">CHI TIẾT SẢN PHẨM</p>
            <h1>@Model.Name</h1>
            <p class="text-muted">Mã món: <code>@Model.Id</code></p>
        </div>
        <div class="d-flex gap-2">
            <a href="@returnUrl" class="btn btn-outline-secondary">
                <svg class="icon"><use href="#i-arrow" /></svg>
                <span>Về danh sách</span>
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" asp-route-returnUrl="@returnUrl" class="btn btn-primary" aria-label="Sửa món @Model.Name">
                Sửa món
            </a>
        </div>
    </div>
    <div class="product-detail">
        <img src="@Model.ImageUrl" data-image-fallback alt="@Model.Name" />
        <dl>
            <dt>Danh mục</dt><dd>@(Model.Category?.Name ?? "—")</dd>
            <dt>Giá bán</dt><dd class="price-cell">@Model.Price.ToString("N0") ₫</dd>
            <dt>Giá gốc</dt><dd>@(Model.OriginalPrice?.ToString("N0") ?? "—") @(Model.OriginalPrice.HasValue ? "₫" : "")</dd>
            <dt>Trạng thái</dt><dd><span class="status-pill @(Model.IsAvailable ? "available" : "stopped")">@(Model.IsAvailable ? "Đang bán" : "Ngừng bán")</span></dd>
            <dt>Mô tả</dt><dd>@(string.IsNullOrWhiteSpace(Model.Description) ? "Chưa có mô tả" : Model.Description)</dd>
            <dt>Ngày tạo</dt><dd>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
        </dl>
    </div>
</div>
