<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FF5722" />
    <title>@ViewData["Title"] · CafePOS Management</title>
    <link rel="icon" type="image/svg+xml" href="~/images/cafepos-mark.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@ViewData["PageClass"]">
    @{ var currentController = ViewContext.RouteData.Values["controller"]?.ToString(); }
    <partial name="_PosIcons" />
    <a class="skip-link" href="#main-content">Đến nội dung chính</a>
    <header class="app-header">
        <div class="d-flex align-items-center gap-2">
            <a class="brand" asp-controller="Pos" asp-action="Index" aria-label="CafePOS — Trang bán hàng">
                <img src="~/images/cafepos-mark.svg" width="40" height="40" alt="" />
                <span>Cafe<span class="brand-accent">POS</span><small>QUẢN LÝ BÁN HÀNG</small></span>
            </a>
            <nav class="nav-links ms-3 d-flex gap-2" aria-label="Điều hướng chính">
                <a asp-controller="Pos" asp-action="Index" class="nav-action @(currentController == "Pos" ? "selected" : "")" aria-current="@(currentController == "Pos" ? "page" : null)">Bán hàng (POS)</a>
                @if (User.IsInRole("Manager"))
                {
                    <a asp-controller="Products" asp-action="Index" data-manage-link class="nav-action @((currentController == "Products" || currentController == "Categories" || currentController == "Lab3") ? "selected" : "")" aria-current="@(currentController == "Products" ? "page" : null)">Quản lý hệ thống</a>
                }
            </nav>
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Login" asp-action="Profile" class="account-link ms-auto"><strong>@User.Identity?.Name</strong><small>@(User.IsInRole("Manager") ? "Quản lý" : "Nhân viên") · Thông tin cá nhân</small></a>
            @if (!IsSectionDefined("PosToolbar"))
            {
                <form asp-controller="Login" asp-action="Logout" method="post"><button type="submit" class="btn btn-sm btn-outline-secondary">Đăng xuất</button></form>
            }
        }
        @if (IsSectionDefined("PosToolbar"))
        {
            @await RenderSectionAsync("PosToolbar", required: false)
        }
    </header>
    <main id="main-content" class="app-main" tabindex="-1">@RenderBody()</main>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
