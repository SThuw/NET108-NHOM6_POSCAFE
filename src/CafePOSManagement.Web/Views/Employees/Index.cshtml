@model IReadOnlyList<EmployeeListItem>
@{
    ViewData["Title"] = "Quản lý nhân viên";
    ViewData["PageClass"] = "management-page";
}

<div class="management-shell">
    <div class="management-heading">
        <div>
            <p class="management-eyebrow">NHÂN SỰ VÀ TÀI KHOẢN</p>
            <h1>Quản lý nhân viên</h1>
            <p>Theo dõi vai trò và trạng thái đăng nhập của nhân viên PolyCafe.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">Thêm nhân viên</a>
    </div>

    @if (TempData["EmployeesMessage"] is string message)
    {
        <div class="alert alert-success" role="status">@message</div>
    }
    @if (TempData["EmployeesError"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <div class="management-stats" aria-label="Thống kê nhân viên">
        <div><span>Tổng tài khoản</span><strong>@Model.Count</strong></div>
        <div><span>Đang hoạt động</span><strong>@Model.Count(employee => employee.IsActive)</strong></div>
        <div><span>Quản lý</span><strong>@Model.Count(employee => employee.IsManager && employee.IsActive)</strong></div>
    </div>

    <div class="management-table-wrap">
        <div class="management-table-top">
            <h2>Danh sách nhân viên</h2>
            <span>@Model.Count tài khoản</span>
        </div>
        @if (Model.Count == 0)
        {
            <div class="management-empty">
                <h3>Chưa có nhân viên</h3>
                <p>Thêm tài khoản đầu tiên để bắt đầu phân quyền sử dụng hệ thống.</p>
                <a asp-action="Create" class="btn btn-primary">Thêm nhân viên</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table management-table align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Mã</th>
                            <th scope="col">Họ và tên</th>
                            <th scope="col">Email</th>
                            <th scope="col">Vai trò</th>
                            <th scope="col">Trạng thái</th>
                            <th scope="col">Ngày tạo</th>
                            <th scope="col">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var employee in Model)
                    {
                        <tr>
                            <td data-label="Mã"><code>@employee.Id</code></td>
                            <td data-label="Họ và tên"><strong>@employee.FullName</strong></td>
                            <td data-label="Email">@employee.Email</td>
                            <td data-label="Vai trò">@(employee.IsManager ? "Manager - Quản lý" : "Employee - Nhân viên")</td>
                            <td data-label="Trạng thái">
                                <span class="status-pill @(employee.IsActive ? "available" : "stopped")">
                                    @(employee.IsActive ? "Hoạt động" : "Đã khóa")
                                </span>
                            </td>
                            <td data-label="Ngày tạo">@employee.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td data-label="Thao tác">
                                <div class="row-actions align-items-center">
                                    <a asp-action="Edit" asp-route-id="@employee.Id" aria-label="Sửa nhân viên @employee.FullName">Sửa</a>
                                    @if (employee.IsActive)
                                    {
                                        <form asp-action="Delete" asp-route-id="@employee.Id" method="post" class="d-inline" onsubmit="return confirm('Khóa tài khoản @employee.Email?');">
                                            <button type="submit" class="border-0 bg-transparent p-0 text-danger fw-semibold" style="font-size: 13px;">Khóa</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
