@{
    ViewData["Title"] = "Không có quyền truy cập";
    ViewData["PageClass"] = "management-page";
}
<div class="management-shell">
    <div class="management-card form-shell mx-auto text-center py-5">
        <div class="mb-3 text-warning">
            <svg class="icon" style="width: 48px; height: 48px;"><use href="#i-refresh" /></svg>
        </div>
        <h1 class="h4 mb-2 text-dark">Không có quyền truy cập</h1>
        <p class="text-muted mb-4">Tài khoản hiện tại của bạn không được phân quyền để thực hiện chức năng này.</p>
        <a asp-controller="Pos" asp-action="Index" class="btn btn-primary">
            <span>Về quầy bán hàng (POS)</span>
            <svg class="icon"><use href="#i-arrow" /></svg>
        </a>
    </div>
</div>
