@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="auth-card-brand">
        <span class="auth-badge">HỆ THỐNG NỘI BỘ</span>
        <h1 class="auth-card-title">Đăng nhập tài khoản</h1>
        <p class="auth-card-desc">Quản lý bán hàng quầy thu ngân &amp; thực đơn PolyCafe</p>
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Count > 0)
    {
        <div class="alert alert-danger" role="alert">
            <svg class="icon me-2 flex-shrink-0"><use href="#i-note" /></svg>
            <div>@Html.ValidationSummary(true, "", new { @class = "mb-0" })</div>
        </div>
    }

    <form asp-action="Login" method="post" data-disable-on-submit class="auth-form">
        <input asp-for="ReturnUrl" type="hidden" />

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email tài khoản <span class="text-danger" aria-hidden="true">*</span></label>
            <input asp-for="Email" class="form-control" autocomplete="username" autofocus required placeholder="ten@polycafe.vn" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label">Mật khẩu <span class="text-danger" aria-hidden="true">*</span></label>
            <div class="password-input-group">
                <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" required placeholder="Nhập mật khẩu..." id="login-password" />
                <button type="button" class="btn-password-toggle" data-password-toggle="#login-password" aria-label="Hiện mật khẩu" title="Hiện hoặc ẩn mật khẩu">
                    <svg class="icon icon-eye"><use href="#i-eye" /></svg>
                    <svg class="icon icon-eye-off" hidden><use href="#i-eye-off" /></svg>
                </button>
            </div>
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
            <div class="form-check">
                <input asp-for="RememberMe" class="form-check-input" id="remember-me" />
                <label asp-for="RememberMe" class="form-check-label" for="remember-me">Duy trì đăng nhập trên thiết bị này</label>
            </div>
            <a asp-action="ForgotPassword">Quên mật khẩu?</a>
        </div>

        <button type="submit" class="btn btn-primary w-100 auth-submit-btn mb-3" data-saving-label="Đang đăng nhập...">
            <span>Đăng nhập hệ thống</span>
            <svg class="icon"><use href="#i-arrow" /></svg>
        </button>

        <div class="border-top pt-3 mt-3">
            <p class="small text-muted fw-bold mb-2">⚡ TÀI KHOẢN MẪU DÙNG THỬ (BẤM ĐỂ TỰ ĐIỀN):</p>
            <div class="d-flex flex-column gap-2">
                <button type="button" class="btn btn-sm btn-outline-primary text-start fw-bold" onclick="fillAccount('thu@polycafe.vn', '123456')">
                    👑 Quản lý: Nguyễn Kim Song Thư (Full quyền)
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary text-start fw-bold" onclick="fillAccount('admin@polykafe.local', 'Admin@123')">
                    🛡️ Quản lý: Hệ thống Admin (admin@polykafe.local)
                </button>
                <button type="button" class="btn btn-sm btn-outline-info text-start fw-bold" onclick="fillAccount('duc@polycafe.vn', '123456')">
                    👔 Nhân viên bán hàng: Ninh Văn Đức (Quầy POS)
                </button>
            </div>
            <div class="text-center mt-3 pt-2 border-top">
                <a href="/Kiosk" class="btn btn-link text-decoration-none fw-bold small text-primary">
                    Mở Màn Hình Máy Kiosk Tự Phục Vụ ➔
                </a>
            </div>
        </div>
    </form>
</div>

<script>
    function fillAccount(email, pass) {
        const emailEl = document.querySelector('input[name="Email"]');
        const passEl = document.getElementById('login-password');
        if (emailEl) emailEl.value = email;
        if (passEl) passEl.value = pass;
    }
</script>
