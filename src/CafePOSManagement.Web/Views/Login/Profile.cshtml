@model UserProfileViewModel
@{
    ViewData["Title"] = "Thông tin cá nhân";
    ViewData["PageClass"] = "management-page";
}
<div class="management-shell">
    <div class="management-heading">
        <div>
            <p class="management-eyebrow">TÀI KHOẢN HỆ THỐNG</p>
            <h1>Thông tin cá nhân</h1>
            <p class="text-muted">Chi tiết hồ sơ nhân sự đang đăng nhập quầy thu ngân.</p>
        </div>
        <a asp-controller="Pos" asp-action="Index" class="btn btn-outline-secondary">
            <svg class="icon"><use href="#i-arrow" /></svg>
            <span>Về quầy bán hàng</span>
        </a>
    </div>

    <div class="management-card form-shell mx-auto">
        <dl class="row mb-4">
            <dt class="col-sm-4 py-2 text-muted fw-semibold">Mã nhân viên</dt>
            <dd class="col-sm-8 py-2"><code>@Model.Id</code></dd>
            <dt class="col-sm-4 py-2 text-muted fw-semibold">Họ và tên</dt>
            <dd class="col-sm-8 py-2"><strong>@Model.FullName</strong></dd>
            <dt class="col-sm-4 py-2 text-muted fw-semibold">Email tài khoản</dt>
            <dd class="col-sm-8 py-2">@Model.Email</dd>
            <dt class="col-sm-4 py-2 text-muted fw-semibold">Số điện thoại</dt>
            <dd class="col-sm-8 py-2">@(string.IsNullOrWhiteSpace(Model.Phone) ? "Chưa cập nhật" : Model.Phone)</dd>
            <dt class="col-sm-4 py-2 text-muted fw-semibold">Vai trò phân quyền</dt>
            <dd class="col-sm-8 py-2"><span class="badge bg-primary-subtle text-primary border border-primary-subtle">@Model.Role</span></dd>
        </dl>

        <div class="d-flex gap-2 justify-content-end pt-3 border-top">
            <a asp-controller="Pos" asp-action="Index" class="btn btn-outline-secondary">Về quầy POS</a>
            <form asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="btn btn-primary">Đăng xuất</button>
            </form>
        </div>
    </div>
</div>
