@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="auth-card-brand">
        <span class="auth-badge">CẤP LẠI MẬT KHẨU</span>
        <h1 class="auth-card-title">Quên mật khẩu?</h1>
        <p class="auth-card-desc">Nhập email nhân viên để nhận mật khẩu mới.</p>
    </div>

    @if (TempData["ResetMessage"] is string message)
    {
        <div class="alert alert-success" role="status">@message</div>
    }

    <form asp-action="ForgotPassword" method="post" data-disable-on-submit class="auth-form">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="mb-4">
            <label asp-for="Email" class="form-label">Email nhân viên <span class="text-danger" aria-hidden="true">*</span></label>
            <input asp-for="Email" class="form-control" type="email" autocomplete="email" autofocus required placeholder="ten@polycafe.vn" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100 auth-submit-btn" data-saving-label="Đang gửi...">Gửi mật khẩu mới</button>
    </form>

    <div class="auth-footer-help">
        <a asp-action="Login">Quay lại đăng nhập</a>
    </div>
</div>
