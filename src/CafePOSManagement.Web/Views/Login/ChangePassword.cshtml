@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    ViewData["PageClass"] = "management-page";
}

<div class="management-shell form-shell">
    <div class="management-heading">
        <div>
            <p class="management-eyebrow">BẢO MẬT TÀI KHOẢN</p>
            <h1>Đổi mật khẩu</h1>
            <p>Mật khẩu mới phải có ít nhất 8 ký tự và khác mật khẩu hiện tại.</p>
        </div>
    </div>

    <form asp-action="ChangePassword" method="post" class="management-form" data-disable-on-submit>
        <input type="email" name="username" value="@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value" autocomplete="username" class="visually-hidden" tabindex="-1" aria-hidden="true" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="form-grid">
            <div class="full">
                <label asp-for="CurrentPassword" class="form-label"></label>
                <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" autofocus />
                <span asp-validation-for="CurrentPassword" class="field-error"></span>
            </div>
            <div>
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="field-error"></span>
            </div>
            <div>
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>
        </div>
        <div class="form-actions">
            <a asp-action="Profile" class="btn btn-outline-secondary">Hủy</a>
            <button type="submit" class="btn btn-primary" data-saving-label="Đang lưu...">Đổi mật khẩu</button>
        </div>
    </form>
</div>
