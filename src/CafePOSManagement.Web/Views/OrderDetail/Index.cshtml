@model OrderDetailViewModel
@{
    ViewData["Title"] = $"Chi tiết hóa đơn {Model.Order.OrderNumber}";
    ViewData["PageClass"] = "order-detail-page";
}

<style>
    .order-detail-shell { max-width: 1080px; margin: 0 auto; padding: 32px 20px 56px; }
    .order-detail-heading { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; margin-bottom: 24px; }
    .order-detail-heading h1 { margin: 0 0 6px; font-size: clamp(24px, 4vw, 34px); }
    .order-detail-heading p { margin: 0; color: #687386; }
    .order-detail-actions { display: flex; flex-wrap: wrap; gap: 10px; }
    .order-detail-card { padding: 24px; margin-bottom: 20px; border: 1px solid #e6e9ef; border-radius: 14px; background: #fff; box-shadow: 0 8px 24px rgba(30, 42, 60, .05); }
    .order-detail-meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 20px; margin: 0; }
    .order-detail-meta dt { margin-bottom: 5px; color: #687386; font-size: 13px; }
    .order-detail-meta dd { margin: 0; font-weight: 600; }
    .order-detail-card h2 { margin: 0 0 18px; font-size: 19px; }
    .order-detail-table th { color: #687386; font-size: 13px; font-weight: 600; }
    .order-detail-total { font-size: 20px; font-weight: 700; }
    .order-detail-note { margin: 20px 0 0; padding: 14px; border-radius: 10px; background: #f7f8fa; }
    .receipt-print { display: none; }
    @@media (max-width: 600px) {
        .order-detail-shell { padding: 22px 14px 40px; }
        .order-detail-heading { flex-direction: column; }
        .order-detail-card { padding: 18px 14px; }
    }
    @@media print {
        @@page { size: 80mm auto; margin: 4mm; }
        body * { visibility: hidden !important; }
        .receipt-print { display: block !important; }
        #print-receipt, #print-receipt * { visibility: visible !important; }
        #print-receipt {
            position: absolute;
            inset: 0 auto auto 0;
            display: block !important;
            width: 72mm;
            color: #000;
            background: #fff;
            font-family: Arial, sans-serif;
            font-size: 11px;
        }
        #print-receipt h1 { margin: 0 0 4px; font-size: 18px; text-align: center; }
        #print-receipt p { margin: 3px 0; }
        #print-receipt .receipt-center { text-align: center; }
        #print-receipt .receipt-rule { border-top: 1px dashed #555; margin: 9px 0; }
        #print-receipt table { width: 100%; border-collapse: collapse; }
        #print-receipt th, #print-receipt td { padding: 4px 0; text-align: left; vertical-align: top; }
        #print-receipt .receipt-number { text-align: right; white-space: nowrap; }
        #print-receipt .receipt-total { font-size: 14px; font-weight: 700; }
    }
</style>

<main class="order-detail-shell">
    <header class="order-detail-heading">
        <div>
            <p>QUẢN LÝ BÁN HÀNG</p>
            <h1>Hóa đơn @Model.Order.OrderNumber</h1>
            <p>Chi tiết món đã gọi và thông tin thanh toán.</p>
        </div>
        <div class="order-detail-actions">
            <a asp-controller="OrderAdmin" asp-action="Index" class="btn btn-outline-secondary">Danh sách hóa đơn</a>
            <button type="button" class="btn btn-primary" onclick="window.print()">In hóa đơn</button>
        </div>
    </header>

    <section class="order-detail-card" aria-label="Thông tin hóa đơn">
        <dl class="order-detail-meta">
            <div><dt>Mã hóa đơn</dt><dd>@Model.Order.OrderNumber</dd></div>
            <div><dt>Trạng thái</dt><dd>@Model.Order.Status</dd></div>
            <div><dt>Nhân viên tạo đơn</dt><dd>@Model.EmployeeName</dd></div>
            <div><dt>Ngày giờ tạo</dt><dd>@Model.Order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd></div>
            <div><dt>Loại đơn</dt><dd>@(Model.Order.OrderType switch { "pickup" => "Mang đi", "delivery" => "Giao hàng", "dinein" => "Tại bàn", _ => Model.Order.OrderType })</dd></div>
            <div><dt>Thanh toán</dt><dd>@(Model.Order.PaymentMethod switch { "cash" => "Tiền mặt", "card" => "Thẻ ngân hàng", "wallet" => "Ví điện tử", _ => Model.Order.PaymentMethod })</dd></div>
        </dl>
        @if (!string.IsNullOrWhiteSpace(Model.Order.Note))
        {
            <p class="order-detail-note"><strong>Ghi chú:</strong> @Model.Order.Note</p>
        }
    </section>

    <section class="order-detail-card" aria-labelledby="order-items-heading">
        <h2 id="order-items-heading">Món trong hóa đơn</h2>
        <div class="table-responsive">
            <table class="table order-detail-table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Tên món</th>
                        <th scope="col" class="text-end">Đơn giá</th>
                        <th scope="col" class="text-end">Số lượng</th>
                        <th scope="col" class="text-end">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Order.Items)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td class="text-end text-nowrap">@item.UnitPrice.ToString("N0") ₫</td>
                        <td class="text-end">@item.Quantity</td>
                        <td class="text-end text-nowrap">@item.LineTotal.ToString("N0") ₫</td>
                    </tr>
                }
                </tbody>
                <tfoot>
                    <tr><th colspan="3" class="text-end">Tạm tính</th><td class="text-end text-nowrap">@Model.Order.Subtotal.ToString("N0") ₫</td></tr>
                    @if (Model.Order.DiscountAmount > 0)
                    {
                        <tr><th colspan="3" class="text-end">Giảm giá (@Model.Order.DiscountPercent.ToString("0.##")%)</th><td class="text-end text-nowrap">-@Model.Order.DiscountAmount.ToString("N0") ₫</td></tr>
                    }
                    @if (Model.Order.TaxAmount > 0)
                    {
                        <tr><th colspan="3" class="text-end">Thuế VAT (@Model.Order.TaxPercent.ToString("0.##")%)</th><td class="text-end text-nowrap">@Model.Order.TaxAmount.ToString("N0") ₫</td></tr>
                    }
                    <tr><th colspan="3" class="text-end">Tổng cộng</th><td class="text-end text-nowrap order-detail-total">@Model.Order.Total.ToString("N0") ₫</td></tr>
                </tfoot>
            </table>
        </div>
    </section>

    <div class="receipt-print">
        @await Html.PartialAsync("_PrintReceipt", Model)
    </div>
</main>
