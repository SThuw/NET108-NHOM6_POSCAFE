@section Scripts {
    <script>
        // Hàm lưu nháp chat vào bộ nhớ trình duyệt (để khi chuyển trang quay lại vẫn còn)
        function saveChatDraft() {
            const history = document.getElementById('ai-chat-history');
            if(history) sessionStorage.setItem('ai-chat-draft', history.innerHTML);
        }

        // Hàm tải nháp chat khi vừa vào trang
        function loadChatDraft() {
            const history = document.getElementById('ai-chat-history');
            const draft = sessionStorage.getItem('ai-chat-draft');
            if(history && draft) history.innerHTML = draft;
        }

        // Hàm gửi tin nhắn
        function sendAiMessage() {
            const input = document.getElementById('ai-message-input');
            const message = input.value.trim();
            if (!message) return;

            const history = document.getElementById('ai-chat-history');
            if(history.querySelector('.fst-italic')) history.innerHTML = '';

            // Hiển thị tin nhắn của Bạn
            history.innerHTML += `<div class="p-2 bg-light rounded-2 border align-self-end" style="max-width: 80%;"><span class="badge bg-secondary me-1">Bạn</span> ${message}</div>`;
            input.value = '';
            history.scrollTop = history.scrollHeight;

            const token = document.cookie.split('; ').find(row => row.startsWith('.AspNetCore.Antiforgery.'))?.split('=')[1];
            
            fetch('/Lab3/SendAiMessage', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token || '' },
                body: `message=${encodeURIComponent(message)}`
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    // Hiển thị tin nhắn của AI
                    history.innerHTML += `<div class="p-2 bg-primary-subtle text-primary-emphasis rounded-2 border border-primary-subtle" style="max-width: 80%;"><span class="badge bg-primary me-1">Trợ lý AI</span> <div style="white-space: pre-wrap;">${data.reply}</div></div>`;
                    history.scrollTop = history.scrollHeight;

                    // Lưu nháp chat
                    saveChatDraft();

                    // TẢI LẠI PHẦN LỊCH SỬ BÊN DƯỚI BẰNG AJAX (KHÔNG F5)
                    fetch('/Lab3?tab=ai')
                        .then(res => res.text())
                        .then(html => {
                            const parser = new DOMParser();
                            const doc = parser.parseFromString(html, 'text/html');
                            const newList = doc.getElementById('ai-sessions-list');
                            const oldList = document.getElementById('ai-sessions-list');
                            if (newList && oldList) {
                                oldList.innerHTML = newList.innerHTML;
                            }
                        });
                } else {
                    history.innerHTML += `<div class="text-danger small">Lỗi: ${data.message}</div>`;
                }
            })
            .catch(err => alert('Lỗi kết nối đến AI.'));
        }

        // Nút Xóa đoạn chat (Chỉ xóa khung chat, KHÔNG xóa DB)
        function clearChatBox() {
            const history = document.getElementById('ai-chat-history');
            history.innerHTML = `<div class="text-muted small fst-italic">Hãy nhập câu hỏi để AI tư vấn món...</div>`;
            sessionStorage.removeItem('ai-chat-draft'); // Xóa nháp
        }

        // Nút Xóa lịch sử (Xóa DB + Xóa khung chat)
        function deleteAiHistory() {
            if (!confirm("Bạn có chắc chắn muốn xóa TOÀN BỘ lịch sử trò chuyện AI không?")) return;

            const token = document.cookie.split('; ').find(row => row.startsWith('.AspNetCore.Antiforgery.'))?.split('=')[1];
            
            fetch('/Lab3/DeleteAiHistory', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token || '' }
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    sessionStorage.removeItem('ai-chat-draft');
                    window.location.href = '/Lab3?tab=ai&t=' + new Date().getTime(); 
                } else {
                    alert("Lỗi: " + data.message);
                }
            })
            .catch(err => alert("Lỗi kết nối khi xóa lịch sử."));
        }

        // Hàm updateStatus cũ (giữ nguyên nếu mày có dùng)
        function updateStatus(orderId, newStatus) {
            const token = document.cookie.split('; ').find(row => row.startsWith('.AspNetCore.Antiforgery.'))?.split('=')[1];
            fetch('/Lab3/UpdateOrderStatus', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token || '' },
                body: `id=${orderId}&newStatus=${encodeURIComponent(newStatus)}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) window.location.reload();
                else alert(data.message);
            })
            .catch(error => alert('Lỗi cập nhật trạng thái.'));
        }

                // --- LOGIC CRUD CARDS ---
        function showAddCardModal() {
            document.getElementById('cardModalTitle').innerText = 'Thêm thẻ mới';
            document.getElementById('card-id').value = '';
            document.getElementById('card-code').value = '';
            document.getElementById('card-name').value = '';
            document.getElementById('card-status-container').style.display = 'none';
            bootstrap.Modal.getOrCreateInstance(document.getElementById('cardModal')).show();
        }

        function showEditCardModal(id, code, name, status) {
            document.getElementById('cardModalTitle').innerText = 'Sửa thẻ';
            document.getElementById('card-id').value = id;
            document.getElementById('card-code').value = code;
            document.getElementById('card-name').value = name;
            document.getElementById('card-status').checked = status;
            document.getElementById('card-status-container').style.display = 'block';
            bootstrap.Modal.getOrCreateInstance(document.getElementById('cardModal')).show();
        }

                function saveCard() {
            const id = document.getElementById('card-id').value;
            const code = document.getElementById('card-code').value.trim();
            const name = document.getElementById('card-name').value.trim();
            const status = document.getElementById('card-status').checked;
            if(!code || !name) { alert('Vui lòng nhập đủ Mã và Tên thẻ.'); return; }

            const token = document.cookie.split('; ').find(row => row.startsWith('.AspNetCore.Antiforgery.'))?.split('=')[1];
            const isEdit = id !== '';
            const url = isEdit ? '/Cards/Update' : '/Cards/Create';
            
            let body = `code=${encodeURIComponent(code)}&name=${encodeURIComponent(name)}`;
            if(isEdit) {
                body += `&id=${encodeURIComponent(id)}&status=${status}`;
            }

            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token || '' },
                body: body
            })
            .then(async res => {
                const data = await res.json();
                if (res.ok && data.success) { 
                    window.location.reload(); 
                } else { 
                    alert(data.message || 'Thao tác không thành công.'); 
                }
            })
            .catch(err => {
                console.error(err);
                alert('Lỗi khi gửi dữ liệu lên server.');
            });
        }

        function deleteCard(id) {
            if (!confirm('Bạn có chắc muốn xóa thẻ này?')) return;
            const token = document.cookie.split('; ').find(row => row.startsWith('.AspNetCore.Antiforgery.'))?.split('=')[1];
            
            fetch('/Cards/Delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token || '' },
                body: `id=${encodeURIComponent(id)}`
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) { window.location.reload(); }
                else { alert(data.message); }
            })
            .catch(err => alert('Lỗi kết nối.'));
        }

                // BỘ LỌC TỔNG HỢP: THEO MÃ HÓA ĐƠN VÀ KHOẢNG NGÀY
        function filterOrders() {
            const codeInput = document.getElementById('search-order').value.trim().toLowerCase();
            const fromDate = document.getElementById('filter-from-date').value;
            const toDate = document.getElementById('filter-to-date').value;
            
            const rows = document.querySelectorAll('#orders-tbody tr');

            rows.forEach(row => {
                const rowCode = row.getAttribute('data-code') || '';
                const rowDate = row.getAttribute('data-date') || ''; // yyyy-MM-dd

                let matchCode = !codeInput || rowCode.includes(codeInput);
                let matchDate = true;

                if (fromDate && rowDate < fromDate) matchDate = false;
                if (toDate && rowDate > toDate) matchDate = false;

                if (matchCode && matchDate) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        // NÚT ĐẶT LẠI BỘ LỌC
        function resetOrderFilter() {
            document.getElementById('search-order').value = '';
            document.getElementById('filter-from-date').value = '';
            document.getElementById('filter-to-date').value = '';
            filterOrders();
        }

        // HÀM XEM CHI TIẾT HÓA ĐƠN
        function viewOrderDetail(orderId) {
            fetch(`/Lab3/GetOrderDetail?id=${orderId}`)
                .then(res => res.json())
                .then(data => {
                    if (!data.success) {
                        alert(data.message || 'Không thể tải chi tiết đơn hàng.');
                        return;
                    }

                    const o = data.order;
                    document.getElementById('modal-order-code').innerText = o.code;
                    document.getElementById('modal-order-date').innerText = o.createdAt;
                    document.getElementById('modal-order-type').innerText = o.orderType;
                    document.getElementById('modal-order-payment').innerText = o.paymentMethod;
                    document.getElementById('modal-order-status').innerText = o.status;
                    document.getElementById('modal-order-employee').innerText = o.employeeName || 'Nguyễn Kim Song Thư';
                    document.getElementById('modal-order-note').innerText = o.note;

                    document.getElementById('modal-subtotal').innerText = o.subtotal.toLocaleString('vi-VN') + ' ₫';
                    document.getElementById('modal-discount').innerText = (o.discountAmount > 0 ? '-' : '') + o.discountAmount.toLocaleString('vi-VN') + ' ₫';
                    document.getElementById('modal-tax').innerText = '+' + o.taxAmount.toLocaleString('vi-VN') + ' ₫';
                    document.getElementById('modal-total').innerText = o.total.toLocaleString('vi-VN') + ' ₫';

                    // Đổi màu badge trạng thái trong modal
                    const statusBadge = document.getElementById('modal-order-status');
                    statusBadge.className = 'badge rounded-pill px-2 mt-1 ' + 
                        (o.status === 'Hoàn thành' ? 'bg-success' : 
                         o.status === 'Đang chuẩn bị' ? 'bg-warning text-dark' : 
                         o.status === 'Chờ nhận món' ? 'bg-primary' : 'bg-danger');

                    // Hiển thị danh sách món
                    const tbody = document.getElementById('modal-items-tbody');
                    tbody.innerHTML = '';
                    if (data.items.length === 0) {
                        tbody.innerHTML = `<tr><td colspan="4" class="text-center text-muted py-3">Không có chi tiết món ăn.</td></tr>`;
                    } else {
                        data.items.forEach(item => {
                            tbody.innerHTML += `
                                <tr>
                                    <td class="ps-3 fw-bold text-dark">${item.productName}</td>
                                    <td class="text-center text-muted small">${item.unitPrice.toLocaleString('vi-VN')} ₫</td>
                                    <td class="text-center"><span class="badge bg-light text-dark border px-2">${item.quantity}</span></td>
                                    <td class="text-end pe-3 fw-bold text-dark">${item.lineTotal.toLocaleString('vi-VN')} ₫</td>
                                </tr>
                            `;
                        });
                    }

                    // Bật modal
                    const modal = new bootstrap.Modal(document.getElementById('orderDetailModal'));
                    modal.show();
                })
                .catch(err => {
                    console.error(err);
                    alert('Lỗi kết nối khi tải chi tiết đơn hàng.');
                });
        }

        // Khởi tạo khi trang tải xong
        document.addEventListener("DOMContentLoaded", function() {
            loadChatDraft(); // Tải lại nháp chat

            const input = document.getElementById('ai-message-input');
            if(input) {
                input.addEventListener('keypress', function (e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        sendAiMessage();
                    }
                });
            }
        });
    </script>
}