@model CafePOSManagement.Web.Models.Entities.Category
@{
    ViewData["Title"] = "Xóa danh mục · " + Model.Name;
    ViewData["PageClass"] = "management-page";
}
<div class="management-shell">
    <div class="management-heading">
        <div>
            <p class="management-eyebrow">XÁC NHẬN THAO TÁC</p>
            <h1>Xóa danh mục thực đơn</h1>
            <p class="text-muted">Kiểm tra thông tin danh mục trước khi xác nhận thao tác.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <svg class="icon"><use href="#i-arrow" /></svg>
            <span>Về danh sách</span>
        </a>
    </div>

    <div class="management-card form-shell mx-auto">
        <div class="p-3 mb-4 rounded-3 bg-light border">
            <h2 class="h5 mb-1 text-dark">@Model.Name</h2>
            <span class="text-muted small">Mã danh mục: <code>@Model.Id</code> · Mã hiển thị: <strong>@Model.Code</strong></span>
        </div>

        <div class="alert alert-danger mb-4" role="alert">
            <strong>Cảnh báo xóa danh mục:</strong>
            <p class="mb-0 mt-1">
                Bạn có chắc chắn muốn xóa danh mục <strong>@Model.Name</strong>? Thao tác này sẽ ẩn danh mục khỏi thực đơn bán hàng.
            </p>
        </div>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-disable-on-submit class="d-flex gap-2 justify-content-end pt-3 border-top">
            <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
            <button type="submit" class="btn btn-danger" data-saving-label="Đang xóa...">Xác nhận xóa danh mục</button>
        </form>
    </div>
</div>
