@model CafePOSManagement.Web.Models.Entities.Category
@{ ViewData["Title"] = "Xóa danh mục"; }
<div class="container py-4" style="max-width: 640px"><h1 class="h3">Xóa danh mục</h1><p>Bạn có chắc muốn xóa <strong>@Model.Name</strong>?</p><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div><form asp-action="Delete" asp-route-id="@Model.Id" method="post"><button type="submit" class="btn btn-danger">Xác nhận xóa</button> <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a></form></div>
