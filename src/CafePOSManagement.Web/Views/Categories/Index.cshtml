@model IReadOnlyList<CafePOSManagement.Web.Models.Entities.Category>
@{ ViewData["Title"] = "Danh mục đồ uống"; }
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center gap-3 mb-4"><h1 class="h3 mb-0">Danh mục đồ uống</h1>@if (User.IsInRole("Manager")) { <a asp-action="Create" class="btn btn-primary">Thêm danh mục</a> }</div>
    @if (Model.Count == 0) { <p>Chưa có danh mục nào.</p> }
    else
    {
        <div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Mã</th><th>Tên</th><th>Mã hiển thị</th><th>Thứ tự</th><th>Thao tác</th></tr></thead><tbody>
        @foreach (var category in Model) { <tr><td>@category.Id</td><td>@category.Name</td><td>@category.Code</td><td>@category.DisplayOrder</td><td><a asp-action="Details" asp-route-id="@category.Id">Xem</a>@if (User.IsInRole("Manager")) { <span> · </span><a asp-action="Edit" asp-route-id="@category.Id">Sửa</a><span> · </span><a asp-action="Delete" asp-route-id="@category.Id">Xóa</a> }</td></tr> }
        </tbody></table></div>
    }
</div>
