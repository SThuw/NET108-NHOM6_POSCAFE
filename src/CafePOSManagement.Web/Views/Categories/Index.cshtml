@model IReadOnlyList<CafePOSManagement.Web.Models.Entities.Category>
@{
    ViewData["Title"] = "Danh mục sản phẩm";
    ViewData["PageClass"] = "management-page";
}
<div class="management-shell">
    <div class="management-heading">
        <div>
            <p class="management-eyebrow">DANH MỤC THỰC ĐƠN</p>
            <h1>Danh mục sản phẩm</h1>
            <p class="text-muted">Phân loại đồ uống và món ăn phục vụ trên hệ thống quầy bán hàng.</p>
        </div>
        @if (User.IsInRole("Manager"))
        {
            <a asp-action="Create" class="btn btn-primary">+ Thêm danh mục mới</a>
        }
    </div>

    <div class="management-stats" aria-label="Thống kê danh mục">
        <div><span>Tổng số danh mục</span><strong>@Model.Count</strong></div>
        <div><span>Đang hoạt động</span><strong>@Model.Count(c => c.IsActive)</strong></div>
        <div><span>Thứ tự cao nhất</span><strong>@(Model.Any() ? Model.Max(c => c.DisplayOrder).ToString() : "0")</strong></div>
    </div>

    <div class="management-table-wrap">
        <div class="management-table-top">
            <h2>Danh sách danh mục</h2>
            <span>@Model.Count danh mục</span>
        </div>
        @if (Model.Count == 0)
        {
            <div class="management-empty">
                <h3>Chưa có danh mục nào</h3>
                <p>Hãy tạo danh mục đầu tiên để phân loại đồ uống và món ăn.</p>
                @if (User.IsInRole("Manager"))
                {
                    <a asp-action="Create" class="btn btn-primary">+ Thêm danh mục mới</a>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table management-table align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Mã danh mục</th>
                            <th scope="col">Tên danh mục</th>
                            <th scope="col">Mã viết tắt</th>
                            <th scope="col" class="text-center">Thứ tự</th>
                            <th scope="col">Trạng thái</th>
                            <th scope="col">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td data-label="Mã danh mục"><code>@category.Id</code></td>
                            <td data-label="Tên danh mục"><strong>@category.Name</strong></td>
                            <td data-label="Mã viết tắt"><span class="badge bg-light text-secondary border">@category.Code</span></td>
                            <td data-label="Thứ tự" class="text-center">@category.DisplayOrder</td>
                            <td data-label="Trạng thái"><span class="status-pill available">Hoạt động</span></td>
                            <td data-label="Thao tác">
                                <div class="row-actions">
                                    <a asp-action="Details" asp-route-id="@category.Id" aria-label="Xem chi tiết danh mục @category.Name">Xem</a>
                                    @if (User.IsInRole("Manager"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@category.Id" aria-label="Sửa danh mục @category.Name">Sửa</a>
                                        <a class="delete-action" asp-action="Delete" asp-route-id="@category.Id" aria-label="Xóa danh mục @category.Name">Xóa</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
